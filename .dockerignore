# File này quyết định thứ KHÔNG được copy vào image.
# Bỏ sót .env = leak secret vào image. Bỏ sót .git = image phình to.

# Secret
.env
.env.*
!.env.example

# Git
.git
.gitignore
.github

# Python / môi trường ảo
.venv
venv
__pycache__
*.pyc
*.pyo
.pytest_cache

# Không cần trong image chạy production
tests
screenshots
*.md
grade.py
nginx
docker-compose.yml
railway.toml
render.yaml
.claude
